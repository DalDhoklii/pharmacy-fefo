generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Medicine {
  id               Int            @id @default(autoincrement())
  name             String
  category         String?
  reorderThreshold Int            @default(20)
  batches          Batch[]
  notifications    Notification[]
}

model Batch {
  id          Int      @id @default(autoincrement())
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  medicineId  Int
  batchNo     String
  quantity    Int
  expiryDate  DateTime
  status      String   @default("ACTIVE") // ACTIVE | NEAR_EXPIRY | QUARANTINED
  createdAt   DateTime @default(now())

  dispenseItems DispenseLogItem[]
}

model DispenseLog {
  id        Int      @id @default(autoincrement())
  medicineId Int
  totalQty   Int
  createdAt  DateTime @default(now())

  items DispenseLogItem[]
}

model DispenseLogItem {
  id            Int         @id @default(autoincrement())
  dispenseLog   DispenseLog @relation(fields: [dispenseLogId], references: [id])
  dispenseLogId Int
  batch         Batch       @relation(fields: [batchId], references: [id])
  batchId       Int
  quantityUsed  Int
}

model Notification {
  id           Int      @id @default(autoincrement())
  medicineId   Int
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  message      String
  currentStock Int
  createdAt    DateTime @default(now())
}